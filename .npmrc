# Fail `npm install` on a wrong Node version instead of letting it through.
#
# This is not theoretical: the project requires Node >= 22 (better-sqlite3@13
# declares the same), and developing on Node 20 produces a confusing failure
# much later - the native binding crashes with no output at all. Failing at
# install time names the real problem.
engine-strict=true

# Do NOT let npm build native modules from source.
#
# better-sqlite3 ships prebuilt Node-API binaries for every platform we target
# (linux-x64, linux-arm64, linuxmusl-*, darwin-*, win32-*) but it ALSO ships a
# binding.gyp. npm's rule is "binding.gyp present and no install script => run
# node-gyp rebuild", so every install tries to compile from source even though
# a perfectly good prebuilt binary is already sitting in the tarball.
#
# The consequences are not cosmetic:
#   - Docker: node:22-bookworm-slim has no python3/make/g++, so `npm ci` fails
#     and the image cannot be built at all.
#   - Windows: fails unless the "Desktop development with C++" workload is
#     installed in Visual Studio.
#   - Everywhere else: several minutes of pointless compiling.
#
# Verified that the prebuilt binary is fully functional on its own (create
# table, insert, select round-trip) and that nothing else in this dependency
# tree relies on a lifecycle script. esbuild does declare a postinstall, but
# its platform package is installed as a normal dependency and tsx works
# without it - confirmed by the test suite passing.
#
# If you ever add a dependency that genuinely needs a postinstall (a code
# generator, a downloaded binary), do not fight this setting: run that one
# install with `npm install --ignore-scripts=false` and record why.
ignore-scripts=true

# The test script quotes its glob ("test/*.test.ts") so that NODE expands it,
# not the shell. npm picks its own shell per platform (bash here, cmd.exe on
# plain Windows) and cmd does not expand globs, which made `npm test` work or
# fail depending on which shell npm happened to choose.
