{
  "name": "sub-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight subscription manager & short-link converter for Subconverter",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.8",
    "kysely": "^0.29.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3"
  }
}
