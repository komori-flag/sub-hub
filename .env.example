# Copy to .env and fill in:   cp .env.example .env
#
# Generate a token with:      openssl rand -hex 32
#
# NOTE: create this file with printf/heredoc, not a Windows editor - a CRLF
# line ending leaves a trailing \r on the value. (The app trims both sides of
# the token so this is survivable, but don't rely on it.)

# Required. /api/* returns 401 without it. The server refuses to start if unset.
ADMIN_TOKEN=

PORT=3000

# The interface to bind. 0.0.0.0 (the default) listens on every interface.
#
# Set 127.0.0.1 when the service is reached through a tunnel or reverse proxy
# rather than by connecting to the port directly: /admin and /api/* then become
# unreachable from the network entirely, instead of depending on the bearer
# token alone. Most relevant when running from source, where there is no
# compose file to express the binding.
# HOST=127.0.0.1

# 0.0.0.0 (the default) publishes the app port on every interface. On a public
# host set this to 127.0.0.1 - the Cloudflare Tunnel reaches the app over the
# compose network, so nothing needs the raw port from outside, and loopback
# keeps it available for local debugging.
# APP_BIND_ADDR=127.0.0.1

# Reachable FROM THE APP. In Docker this is the compose service name; when
# running the app on the host against a containerised subconverter, use
# http://localhost:25500 instead.
SUBCONVERTER_URL=http://subconverter:25500

# Whole-conversion budget: fetching every source + parsing + rendering.
CONVERTER_TIMEOUT_MS=20000

# How long a generated config is reused. Without this every client refresh
# triggers a full Subconverter fan-out to every source, which some providers
# rate-limit or ban for. Set to 0 to disable caching entirely.
#
# Raising this is the cheapest way to stop N clients from hitting the
# providers N times. It is safe to raise a long way: the cache key is a hash
# of every input that changes the output, so editing a profile or a source
# takes effect immediately regardless of the TTL. What a long TTL does make
# stale is the upstream node list itself, and the quota a client displays.
#
# Range 0..86400000 (24h). `?refresh=1` forces a fresh conversion.
CACHE_TTL_MS=90000

# Memory bound for cached config bodies. Real configs run 100 KiB - 2 MiB,
# so this is several dozen entries. Entries are dropped LRU when exceeded.
CACHE_MAX_BYTES=67108864

# How many conversions may run at once. Each one makes Subconverter fan out to
# every source in the profile, so this protects both the subconverter
# container and your providers' rate limits. Requests beyond this queue
# (queue length and wait timeout are derived; see README) and get a 503
# SERVER_BUSY once the queue is full, rather than piling up.
MAX_CONCURRENT_CONVERSIONS=8

# How often each enabled subscription source is probed for availability, node
# count, remaining quota and expiry. Set to 0 to disable monitoring entirely.
#
# Every check costs one Subconverter conversion plus one request to the
# provider, so this is deliberately unhurried - traffic counters and expiry
# dates move slowly.
MONITOR_INTERVAL_MS=21600000

# Grace period before the first probe, so monitoring does not compete for
# conversion slots with whatever traffic arrives at boot.
MONITOR_STARTUP_DELAY_MS=60000

# Serves locally stored templates to subconverter. 0 disables it (and local
# templates then cannot be used at all).
#
# The bind address is hardcoded to 127.0.0.1 and is deliberately NOT
# configurable here: the endpoint has no authentication, because subconverter
# cannot send any, so loopback is the entire access control.
INTERNAL_PORT=0

# Defaults to ./data/sub.db
# DATABASE_PATH=/app/data/sub.db

# The User-Agent sub-hub sends to subconverter. Fixed rather than forwarded
# from the client, so one short link means one config for everyone.
#
# This also decides what `target=auto` resolves to: subconverter picks the
# output format from the requesting UA, and returns "Invalid target!" for a UA
# it does not recognise. Pinning it to a Clash client makes `auto` reliably
# mean clash. Serve a Surge client with its own profile and an explicit target.
#
# MEASURED: this UA also decides what your PROVIDERS return. The same
# subscription URL returned "No nodes were found!" for curl's default UA, for
# a random UA, and for mihomo/1.18.0 - but ~547 KB of nodes for
# clash-verge/v2.5.7. An unrecognised UA makes subscriptions fail outright, and
# the client only sees a generic 502. Change it deliberately.
# SUBCONVERTER_UA=clash-verge/v2.5.7

# Shared secret for the subconverter backend, sent as &token= on every request.
#
# LEAVE EMPTY unless you want it enforced. Setting a value does two things at
# once (see docker-compose.yml): sub-hub starts sending it, AND subconverter
# starts requiring it. One variable, so they cannot drift out of sync.
#
# The compose network already makes subconverter unreachable from the host and
# the internet - it publishes no ports. This token is the layer that limits
# WHICH container may use it, since any container on the same network can
# reach any other. Worth setting if the VPS is shared.
#
#   openssl rand -hex 24
#
# SUBCONVERTER_TOKEN=

# Only needed when running with the `tunnel` compose profile (public deploy).
# From the Cloudflare dashboard: Zero Trust -> Networks -> Tunnels -> create,
# then copy the token out of the `cloudflared service install eyJ...` command.
# TUNNEL_TOKEN=
