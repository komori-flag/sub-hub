# Copy to .env and fill in:   cp .env.example .env
#
# Generate a token with:      openssl rand -hex 32
#
# NOTE: create this file with printf/heredoc, not a Windows editor - a CRLF
# line ending leaves a trailing \r on the value. (The app trims both sides of
# the token so this is survivable, but don't rely on it.)

# Required. /api/* returns 401 without it. The server refuses to start if unset.
ADMIN_TOKEN=

PORT=3000

# 0.0.0.0 (the default) publishes the app port on every interface. On a public
# host set this to 127.0.0.1 - the Cloudflare Tunnel reaches the app over the
# compose network, so nothing needs the raw port from outside, and loopback
# keeps it available for local debugging.
# APP_BIND_ADDR=127.0.0.1

# Reachable FROM THE APP. In Docker this is the compose service name; when
# running the app on the host against a containerised subconverter, use
# http://localhost:25500 instead.
SUBCONVERTER_URL=http://subconverter:25500

# Whole-conversion budget: fetching every source + parsing + rendering.
CONVERTER_TIMEOUT_MS=20000

# How long a generated config is reused. Without this every client refresh
# triggers a full Subconverter fan-out to every source, which some providers
# rate-limit or ban for. Set to 0 to disable caching entirely.
# A burst of simultaneous requests is collapsed into one upstream call
# regardless of this setting, so 0 is not as bad as it sounds.
CACHE_TTL_MS=90000

# Memory bound for cached config bodies. Real configs run 100 KiB - 2 MiB,
# so this is several dozen entries. Entries are dropped LRU when exceeded.
CACHE_MAX_BYTES=67108864

# How many conversions may run at once. Each one makes Subconverter fan out to
# every source in the profile, so this protects both the subconverter
# container and your providers' rate limits. Requests beyond this queue
# (queue length and wait timeout are derived; see README) and get a 503
# SERVER_BUSY once the queue is full, rather than piling up.
MAX_CONCURRENT_CONVERSIONS=8

# Defaults to ./data/sub.db
# DATABASE_PATH=/app/data/sub.db

# Shared secret for the subconverter backend, sent as &token= on every request.
#
# LEAVE EMPTY unless you want it enforced. Setting a value does two things at
# once (see docker-compose.yml): sub-hub starts sending it, AND subconverter
# starts requiring it. One variable, so they cannot drift out of sync.
#
# The compose network already makes subconverter unreachable from the host and
# the internet - it publishes no ports. This token is the layer that limits
# WHICH container may use it, since any container on the same network can
# reach any other. Worth setting if the VPS is shared.
#
#   openssl rand -hex 24
#
# SUBCONVERTER_TOKEN=

# Only needed when running with the `tunnel` compose profile (public deploy).
# From the Cloudflare dashboard: Zero Trust -> Networks -> Tunnels -> create,
# then copy the token out of the `cloudflared service install eyJ...` command.
# TUNNEL_TOKEN=
